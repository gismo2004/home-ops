{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.0.0",
    // Teaches Renovate about factory.talos.dev installer images AND the
    // `talosVersion:` key in talos/topf.yaml, which no generic manager
    // understands. Directly relevant here: this cluster runs a custom
    // schematic (drbd + nvidia -lts), so the installer image is factory-built.
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.0.0",
    ":timezone(Europe/Vienna)",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  packageRules: [
    // ---- Auto-merge -------------------------------------------------------
    // Deliberately narrow. Version bumps of cluster workloads are NOT
    // auto-merged: a Renovate automerge previously took cilium 1.18.6 -> 1.20.0
    // unattended, which is exactly what these rules avoid.
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"], // digest only, never a version change
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      // Normal applications: minor and patch merge unattended. Major never
      // does -- that is where behaviour changes. minimumReleaseAge gives a
      // broken release time to be pulled before it lands here.
      description: "Auto-merge app minor/patch",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      // MUST come after the rule above -- later packageRules win. These are the
      // things that take the whole cluster down when they go wrong, so they
      // always wait for a human regardless of update type. Cilium 1.18.6 ->
      // 1.20.0 once auto-merged itself on the old cluster; coredns took DNS
      // down cluster-wide during this migration.
      description: "Never auto-merge infrastructure",
      matchPackageNames: [
        "/cilium/",
        "/coredns/",
        "/cert-manager/",
        "/cloudnative-pg/",
        "/miroir/",
        "/kopiur/",
        "/snapshot-controller/",
        "/gateway-helm/",
        "/envoy/",
        "/k8s-gateway/",
        "/external-dns/",
        "/flux-operator/",
        "/flux-instance/",
        "/nvidia-device-plugin/",
        "/tuppr/",
        "/k8tz/",
        "/metrics-server/",
        "/kubelet/",
        "siderolabs/talos",
        // app-template is one chart behind ~26 apps, so a single bump changes
        // every workload at once. Its 5.x naming rules have already silently
        // renamed PVCs here; that blast radius belongs with infrastructure.
        "/app-template/",
      ],
      automerge: false,
    },
    {
      description: "Auto-merge Renovate presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // ---- Grouping ---------------------------------------------------------
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      // After the mise catch-all so talos wins its own group. Unites the mise
      // talosctl pin with the factory installer image and topf's talosVersion,
      // so the node image and the CLI never drift apart.
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // ---- Labels -----------------------------------------------------------
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
