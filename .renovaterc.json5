{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    // Teaches Renovate about factory.talos.dev installer images AND the
    // `talosVersion:` key in talos/topf.yaml, which no generic manager
    // understands. Directly relevant here: this cluster runs a custom
    // schematic (drbd + nvidia -lts), so the installer image is factory-built.
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    // Custom datasource against grafana.com/api/dashboards/{id}; rewrites the
    // pinned revision in any file named grafanadashboard.yaml. This is why the
    // dashboards are GrafanaDashboard CRs and not vendored JSON -- Renovate can
    // update a reference, but not a 457KB blob.
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    ":timezone(Europe/Vienna)",
  ],
  // main has no branch protection requiring branches to be up to date, so there's no need to
  // force-rebase a branch just because an unrelated PR merged and moved main's tip. Without this,
  // automerge=true branches default to rebaseWhen=behind-base-branch, which means merging any one
  // automerge PR invalidates the CI status of every other open automerge PR (forces a rebase,
  // wiping their green checks) even when they touch completely disjoint files -- serializing what
  // should be independent merges to ~one per Renovate run.
  rebaseWhen: "conflicted",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  customManagers: [
    {
      // Dashboards that live in the app's own repo rather than on grafana.com
      // (blocky, cloudnative-pg). The `# renovate:` comment above the URL names
      // the datasource and repo; the version in the URL path is what gets
      // bumped, so the dashboard moves in step with the app instead of drifting
      // on a branch.
      description: "Grafana dashboards pinned to an upstream release tag",
      customType: "regex",
      managerFilePatterns: ["/grafanadashboard\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?<gap>\\s+url: )(?<prefix>\\S+?)/(?<currentValue>[a-z-]*v?\\d+\\.\\d+\\.\\d+)/(?<suffix>\\S+)",
      ],
      // Without an explicit template Renovate replaces the WHOLE match with just
      // the new version -- it rewrote the entire url: line to "url: v0.34.0" in
      // PR #17. Prefix and suffix are replayed verbatim so only the version
      // segment changes, and `gap` carries the whitespace so indentation survives.
      autoReplaceStringTemplate: "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{{gap}}}{{{prefix}}}/{{{newValue}}}/{{{suffix}}}",
    },
  ],
  packageRules: [
    // ---- Auto-merge -------------------------------------------------------
    // Default is to merge unattended: digests, and minor/patch for apps, GitHub
    // Actions, Renovate presets and mise tooling. Majors never auto-merge, and
    // the denylist further down carves out the handful of packages where a bad
    // update cannot be walked back with a git revert. Read that rule's comment
    // before adding anything to it -- the criterion is recoverability, not
    // whether something feels like "infrastructure".
    {
      // Images here are pinned `tag: <version>@sha256:...`, so a digest bump is
      // the same application version rebuilt on a newer base layer -- almost
      // always a base-OS CVE patch with no change to the app itself. That makes
      // a digest the lowest-risk update in this repo, lower than a patch bump,
      // so it is not restricted by registry. The denylist below still applies
      // on top. Four images use `tag: latest@sha256:...` (tasmocompiler,
      // unmonitarr, krokiet, edgetx) where a digest bump IS an unlabelled
      // version change -- all four are leaf apps whose config PVCs are backed
      // up by Kopiur, so they carry no more risk than any other app patch.
      description: "Auto-merge OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      // Normal applications: minor and patch merge unattended. Major never
      // does -- that is where behaviour changes.
      description: "Auto-merge app minor/patch",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      // mise pins developer tooling (kubectl, kustomize, sops, helm) -- a bad
      // bump breaks a local command, not a workload. talosctl is the exception
      // and the Talos Group rule below pulls it into its own PR, where the
      // denylist catches it.
      description: "Auto-merge mise tools minor/patch",
      matchManagers: ["mise"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Require 3 days stability for major updates",
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "3 days",
    },
    {
      // MUST come after the rules above -- later packageRules win. The line
      // drawn here is NOT "infrastructure vs application". It is "can a bad
      // update be undone by a git revert?". For everything else on this cluster
      // it can: push a revert and Flux reapplies it within a minute, so an
      // unattended merge is recoverable by definition. The entries below break
      // that recovery path itself, so they wait for a human regardless of
      // update type:
      //
      //   cilium, coredns          Flux cannot pull and nothing in-cluster resolves
      //   flux-operator/-instance  breaks the mechanism that would apply the revert
      //   miroir                   CSI/DRBD on 0.11.x; a bad release can leave PVCs
      //                            unmountable, and a revert does not unbreak a volume
      //   cloudnative-pg           operator upgrades roll the PG clusters
      //   talos, kubelet           node-level, single node, no drain target
      //   kopiur                   a break is silent -- you find out at restore time
      //   app-template             one chart behind ~26 apps; its 5.x naming rules
      //                            have already silently renamed PVCs here
      //
      // Cilium 1.18.6 -> 1.20.0 once auto-merged itself on the old cluster.
      // Note that these projects do not use semver the way applications do: a
      // "minor" for cilium or coredns is a feature release, not a bugfix, which
      // is why the app minor/patch rule above must not reach them.
      //
      // Deliberately NOT here (removed 2026-08-27): cert-manager,
      // snapshot-controller, gateway-helm, envoy, k8s-gateway, external-dns,
      // nvidia-device-plugin, tuppr, k8tz, metrics-server. Breaking any of them
      // costs ingress or telemetry, not the cluster or its data, and kubectl
      // and Flux both keep working -- so a revert is a normal one.
      description: "Never auto-merge anything a git revert cannot undo",
      matchPackageNames: [
        "/cilium/",
        "/coredns/",
        "/cloudnative-pg/",
        "/miroir/",
        "/kopiur/",
        "/flux-operator/",
        "/flux-instance/",
        "/kubelet/",
        "siderolabs/talos",
        "/app-template/",
      ],
      automerge: false,
    },
    {
      description: "Auto-merge Renovate presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      // PostgreSQL major upgrades change on-disk PGDATA format and cannot be
      // done in-place by swapping images. Keep clusters on their pinned major
      // (PG 16) and only track minor/patch/digest updates.
      description: "Never bump CNPG PostgreSQL across major versions",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql", "/cloudnative-pg\\/postgresql/"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    // ---- Grouping ---------------------------------------------------------
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      // After the mise catch-all so talos wins its own group. Unites the mise
      // talosctl pin with the factory installer image and topf's talosVersion,
      // so the node image and the CLI never drift apart.
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // ---- Labels -----------------------------------------------------------
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
